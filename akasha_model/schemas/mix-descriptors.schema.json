{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/azerothl/akasha-model/schemas/mix-descriptors.schema.json",
  "title": "MixDescriptors",
  "description": "Deterministic text/JSON mix descriptors for Path A/B decision state. Audio never enters the package; hosts compute these values outside the model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "tracks"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "sample_rate_hz": {
      "type": "integer",
      "minimum": 8000,
      "maximum": 192000
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/track" }
    },
    "pair_masking": {
      "type": "array",
      "items": { "$ref": "#/$defs/pair_masking" },
      "default": []
    }
  },
  "$defs": {
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track_id",
        "rms_db",
        "lufs",
        "spectral_centroid_hz",
        "band_energies_db",
        "crest_factor_db",
        "stereo_correlation"
      ],
      "properties": {
        "track_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "rms_db": {
          "type": "number",
          "minimum": -120,
          "maximum": 0,
          "description": "RMS level in dBFS, rounded to 0.1 dB by the host serializer."
        },
        "lufs": {
          "type": "number",
          "minimum": -70,
          "maximum": 0,
          "description": "Integrated loudness in LUFS, rounded to 0.1 LU."
        },
        "spectral_centroid_hz": {
          "type": "number",
          "minimum": 20,
          "maximum": 20000,
          "description": "Spectral centroid in Hz, rounded to 1 Hz."
        },
        "band_energies_db": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "description": "Fixed bands low/low-mid/high-mid/high in dBFS, rounded to 0.1 dB.",
          "items": {
            "type": "number",
            "minimum": -120,
            "maximum": 0
          }
        },
        "crest_factor_db": {
          "type": "number",
          "minimum": 0,
          "maximum": 40,
          "description": "Peak-to-RMS crest factor in dB, rounded to 0.1 dB."
        },
        "stereo_correlation": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "Inter-channel correlation in [-1, 1], rounded to 0.01."
        }
      }
    },
    "pair_masking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["masker_id", "maskee_id", "masking_index"],
      "properties": {
        "masker_id": { "type": "string", "minLength": 1 },
        "maskee_id": { "type": "string", "minLength": 1 },
        "masking_index": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Host-computed masking severity in [0, 1], rounded to 0.01."
        }
      }
    }
  }
}
